# Copy to .env and adjust. Never commit real credentials.

# --- data / runtime ---
CLAIMS_DB_PATH=var/claims.db
CLAIMS_TRACE_DIR=traces
CLAIMS_AS_OF_DATE=2026-06-30
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_CALLS_PER_TOOL=3
AGENT_TOOL_RETRIES=2

# --- planner: scripted | openai | azure | bedrock ---
LLM_PROVIDER=scripted

# OpenAI or any OpenAI-compatible server (vLLM, Ollama, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# Amazon Bedrock (credentials via the standard AWS credential chain)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Optional MLflow run logging
MLFLOW_TRACKING_URI=
